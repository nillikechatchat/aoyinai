generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 七大栏目文章
model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  category    String // tutorials | market | majors | events | hackathons | cloud-deals | t-agent
  tags        String   @default("") // 逗号分隔
  cover       String   @default("/images/cover-tutorials.png")
  readMinutes Int      @default(5)
  views       Int      @default(0)
  likes       Int      @default(0)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([publishedAt])
}

// AI 问签记录（司南问一事）
model InsightRecord {
  id        String   @id @default(cuid())
  sessionId String   @default("") // 访客会话 id，「我的签筒」据此隔离
  question  String   @default("")
  name      String // 卦名，如「青云卦」
  oracle    String // 卦辞（文言）
  interpret String // 解曰（白话，联系 AI 行业）
  advice    String // 建议（行动指南）
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

// 栏目定义
model Category {
  id          String @id @default(cuid())
  key         String @unique // tutorials | market ...
  name        String // AI 教程
  en          String // Tutorials
  description String
  seal        String // 栏目印章单字，如「教」
  order       Int    @default(0)
}

// 文章评论（匿名留言板，支持以文会友式的回复）
model Comment {
  id            String   @id @default(cuid())
  articleSlug   String // 所属文章 slug
  parentId      String? // 父评论 id（为空则为顶端留言）
  replyToAuthor String? // 被复者落款（冗余存储，便于展示）
  author        String   @default("无名氏") // 昵称
  body          String // 留言内容
  reactions     Int      @default(0) // 「有同感」计数
  createdAt     DateTime @default(now())

  @@index([articleSlug])
  @@index([parentId])
}
