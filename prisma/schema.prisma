generator client {
  provider = "prisma-client-js"
}

// SQLite schema + Prisma driver adapter：
// - 本地开发：DATABASE_URL=file:./db/custom.db（直连文件）
// - Turso 部署：DATABASE_URL=libsql://<db>-<user>.turso.io?authToken=<token>（src/lib/db.ts 自动切换 libsql adapter）
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 七大栏目文章
model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  category    String // tutorials | market | majors | events | hackathons | cloud-deals | t-agent
  tags        String   @default("") // 逗号分隔
  cover       String   @default("/images/cover-tutorials.png")
  readMinutes Int      @default(5)
  views       Int      @default(0)
  likes       Int      @default(0)
  tldr        String   @default("") // AI 一句话速览（懒生成后缓存）
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([publishedAt])
}

// AI 问签记录（司南问一事）
model InsightRecord {
  id        String   @id @default(cuid())
  sessionId String   @default("") // 访客会话 id，「我的签筒」据此隔离
  question  String   @default("")
  name      String // 卦名，如「青云卦」
  oracle    String // 卦辞（文言）
  interpret String // 解曰（白话，联系 AI 行业）
  advice    String // 建议（行动指南）
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

// 栏目定义
model Category {
  id          String @id @default(cuid())
  key         String @unique // tutorials | market ...
  name        String // AI 教程
  en          String // Tutorials
  description String
  seal        String // 栏目印章单字，如「教」
  order       Int    @default(0)
}

// 文章评论（匿名留言板，支持以文会友式的回复）
model Comment {
  id            String   @id @default(cuid())
  articleSlug   String // 所属文章 slug
  parentId      String? // 父评论 id（为空则为顶端留言）
  replyToAuthor String? // 被复者落款（冗余存储，便于展示）
  author        String   @default("无名氏") // 昵称
  body          String // 留言内容
  reactions     Int      @default(0) // 「有同感」计数
  createdAt     DateTime @default(now())

  @@index([articleSlug])
  @@index([parentId])
}

// 观天 · 社区博客收录（源自 GitHub issue，自动抓取预览，按点击率排序）
model BlogSky {
  id          String   @id @default(cuid())
  issueNumber Int      @unique // 来源 GitHub issue 编号
  title       String // 博客名（issue 标题）
  url         String // 博客地址
  description String   @default("") // 介绍（issue 正文提取）
  author      String   @default("") // 提交者 GitHub 用户名
  avatar      String   @default("") // 提交者头像
  ogImage     String   @default("") // 自动抓取的博客预览图
  clicks      Int      @default(0) // 点击率（观览次数）
  hidden      Boolean  @default(false) // 下架标记
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
